# ---- Application ----
APP_NAME=MTL ANPMRS Backend
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# ---- Database ----
DATABASE_URL=postgresql+psycopg://anpmrs:anpmrs@postgres:5432/anpmrs

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Security ----
# openssl rand -hex 32
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Fernet key used to encrypt monitoring credentials at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Storage ----
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# ---- Browser automation ----
# mock | live
MONITORING_MODE=mock
PLAYWRIGHT_BROWSER_PATH=
PLAYWRIGHT_HEADLESS=true
BROWSER_NAVIGATION_TIMEOUT_MS=30000
BROWSER_GRAPH_RENDER_WAIT_MS=2500

# ---- OCR ----
OCR_ENABLED=false
TESSERACT_CMD=/usr/bin/tesseract

# ---- AI service abstraction ----
# none | openai_compatible
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Seeding ----
SEED_ADMIN_EMAIL=admin@mtl.mw
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ENGINEER_EMAIL=engineer@mtl.mw
SEED_ENGINEER_PASSWORD=ChangeMe123!